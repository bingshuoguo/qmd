# Copy to .env.distill.deepseek-json4-repro.local and set DISTILL_API_KEY.
# This profile reproduces the historical JSON4 DeepSeek v1 prompt strategy.
DISTILL_PROVIDER=deepseek
DISTILL_API_KEY=<deepseek-api-key>
DISTILL_MODEL=deepseek-v4-flash
DISTILL_API_BASE_URL=https://api.deepseek.com
DISTILL_THINKING_MODE=disabled
DISTILL_PROMPT_VERSION=qmd-expansion-teacher-v1-deepseek-json4-repro
DISTILL_SYSTEM_PROMPT_FILE=finetune/benchmarks/distill/prompts/deepseek-json4-repro-system.txt
DISTILL_USER_PROMPT_TEMPLATE_FILE=finetune/benchmarks/distill/prompts/deepseek-json4-repro-user.txt
DISTILL_MAX_OUTPUT_TOKENS=4096
