# Copy the selected profile to .env.distill.local and add credentials/endpoint there.
DISTILL_PROMPT_VERSION=qmd-expansion-teacher-v2
DISTILL_SYSTEM_PROMPT="Generate semantics-preserving search expansions for QMD biomedical hybrid retrieval. Return 1-3 lex expansions using abbreviations, full names, aliases, strict synonyms, or key-term combinations; 1-3 vec expansions expressing the same proposition in natural retrieval language; and optionally one concise 32-128 token HyDE abstract-style passage discussing evidence relevant to assessing the query without assuming it is true. Preserve entities and their roles, numbers, ranges, proportions, time, negation, polarity, comparison and causal direction, correlation versus causation, uncertainty, conditionality, and whether the input is a question or statement. Do not answer the query, add unsupported mechanisms or qualifiers, reverse relationships, or include reasoning or chat-template markers."
DISTILL_USER_PROMPT_TEMPLATE="Generate neutral, semantics-preserving retrieval expansions for: {{query}}"
DISTILL_MAX_OUTPUT_TOKENS=4096
