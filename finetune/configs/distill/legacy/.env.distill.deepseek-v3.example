# Copy to .env.distill.local, then set DISTILL_API_KEY locally. Never commit the key.
DISTILL_PROVIDER=deepseek
DISTILL_API_KEY=<deepseek-api-key>
DISTILL_MODEL=deepseek-v4-flash
DISTILL_API_BASE_URL=https://api.deepseek.com
DISTILL_THINKING_MODE=disabled
DISTILL_PROMPT_VERSION=qmd-expansion-teacher-v3-deepseek-scifact-unverified-claim
DISTILL_SYSTEM_PROMPT_FILE=finetune/benchmarks/distill/prompts/deepseek-v3-scifact-system.txt
DISTILL_USER_PROMPT_TEMPLATE_FILE=finetune/benchmarks/distill/prompts/deepseek-v3-scifact-user.txt
DISTILL_MAX_OUTPUT_TOKENS=4096
