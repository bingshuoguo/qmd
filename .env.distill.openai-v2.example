# Copy to .env.distill.local, then set DISTILL_API_KEY and the compatible
# Responses endpoint locally. Never commit credentials.
DISTILL_PROVIDER=openai-compatible
DISTILL_API_KEY=<openai-compatible-api-key>
DISTILL_RESPONSES_ENDPOINT=<responses-api-endpoint>
DISTILL_MODEL=gpt-5.6-terra
DISTILL_PROMPT_VERSION=qmd-expansion-teacher-v2-openai-rag-semantic-safe
DISTILL_SYSTEM_PROMPT_FILE=finetune/benchmarks/distill/prompts/openai-v2-system.txt
DISTILL_USER_PROMPT_TEMPLATE_FILE=finetune/benchmarks/distill/prompts/openai-v2-user.txt
DISTILL_MAX_OUTPUT_TOKENS=4096
